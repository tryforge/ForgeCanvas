{
  "name": "@tryforge/forge.canvas",
  "version": "1.3.1",
  "description": "A ForgeScript extension allowing you to create and edit images with ease.",
  "main": "dist/index.js",
  "scripts": {
    "prepublish": "tsc && npm run license && typedoc src/index.ts && node dist/docgen",
    "test": "swc src -d dist --strip-leading-paths && node --env-file=.env dist/__tests__/index.js",
    "license": "node dist/@build/license.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryforge/ForgeCanvas.git"
  },
  "keywords": [
    "forgescript",
    "botforge",
    "forge",
    "canvas",
    "image",
    "png",
    "jpeg",
    "gif"
  ],
  "author": "lordex",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/tryforge/ForgeCanvas/issues"
  },
  "homepage": "https://github.com/tryforge/ForgeCanvas#readme",
  "dependencies": {
    "@gifsx/gifsx": "^1.0.15",
    "@napi-rs/canvas": "^1.0.9"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@tryforge/forgescript": "^2.7.1",
    "@types/node": "^22.20.4",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@tryforge/forgescript": "^2"
  },
  "trustedDependencies": [
    "@swc/core"
  ]
}